# Server
PORT=5000
NODE_ENV=development
# Comma-separated allowed origins (defaults to http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=food_delivery_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# bcrypt
BCRYPT_ROUNDS=12
